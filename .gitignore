# ============================================================================
# mcycle-pipeline .gitignore
# Goal: commit the tool + config + small validation artifacts.
# Exclude large/regenerable data (DBs, downloads, per-genome pipeline outputs).
# NOTE: resources/blast_db/ holds the cached BLAST reference sequences fetched
# from UniProt — archive it SEPARATELY (e.g. Zenodo) with a release, because
# UniProt accessions can be deleted; it is intentionally NOT committed here.
# ============================================================================

# ---- Python / Snakemake / OS cruft ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.snakemake/
.DS_Store
*.log

# ---- Local agent / planning state (not part of the public tool) ----
.claude/

# ---- Large regenerable resources (archive separately) ----
resources/.cache/
resources/hmm/
resources/blast_db/

# ---- Pipeline run outputs ----
results/
/validation/.kegg_cache/

# ---- Validation runs (one results dir per study) ----
results_*/

# ---- Comparators: third-party databases and run scratch (normalized TSVs are kept) ----
# MCycDB (Qian et al. 2022) is not redistributed; build_mcycdb_tsv.py regenerates mcycdb.tsv.
comparators/MCyc/
comparators/panel_faa/
comparators/metabolic_in/
comparators/metabolic_out/
comparators/dram_in/
comparators/dram_out/
comparators/mcycdb_out/
comparators/*.log
comparators/gtdb500_m/gtdb_dl/
comparators/gtdb500_m/proteomes/
comparators/gtdb500_m/mcycdb_out/
comparators/gtdb500_m/metabolic_in/
comparators/gtdb500_m/metabolic_out/
comparators/mags_in/
comparators/mags_metabolic_out/
comparators/mags_dram_out/
validation/metagenomes/checkm_out/
comparators/gtdb500_m/metabolic_backbone/
